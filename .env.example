# Copy to .env (git-ignored) on your machine, or export these in your shell.
# OpenRouter key for the Jev (Decisions API) arm. Required only for that arm.
OPENROUTER_API_KEY=
# Qwen arm: any OpenAI-compatible base URL and model id.
QWEN_BASE_URL=
QWEN_MODEL=
# Generic self-hosted decisions endpoint (Laya / fine-tune / SemIf contract).
DECISIONS_BASE_URL=
# Optional: comma-separated expected response model ids for the decisions arm (drift check).
# DECISIONS_EXPECTED_MODEL=english,multilingual,typed-decisions
